{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://know-surgery.local/schemas/surgery-plan.schema.json",
  "title": "Know-Surgery SurgeryPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent",
    "operation",
    "knowledge_type",
    "model_id",
    "dataset_id",
    "methods",
    "num_cases",
    "evaluators",
    "steps",
    "warnings",
    "requires_confirmation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "intent": {"type": "string", "minLength": 1},
    "operation": {"enum": ["unlearning", "inject", "edit"]},
    "knowledge_type": {
      "enum": ["fact", "event", "procedural", "rule", "free_text", "concept", "multimodal"]
    },
    "model_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "methods": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "num_cases": {"type": "integer", "minimum": 1},
    "evaluators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "experiments": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "overrides": {"type": "object"},
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256", "records", "source_sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "records": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "status"],
        "properties": {
          "skill": {"type": "string"},
          "status": {"enum": ["pending", "ready", "blocked", "completed"]},
          "reason": {"type": "string"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "requires_confirmation": {"type": "boolean"}
  }
}
